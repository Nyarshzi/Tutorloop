<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Lamp Login</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

<h1 class="title">Lamp Login</h1>

<div class="container">

  <!-- Lamp -->
  <div class="lamp" onclick="toggleLamp()">
    <div class="light"></div>
    <div class="stand"></div>
  </div>

  <!-- Login Box -->
  <div class="login-box">
    <h2>Welcome</h2>
    <input type="text" placeholder="Username">
    <input type="password" placeholder="Password">
    <button>Sign In</button>
  </div>

</div>

<script src="script.js"></script>
</body>
</html>
